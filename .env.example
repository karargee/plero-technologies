# Copy to .env and fill in (and add the same names in Vercel → Settings → Environment Variables).

# --- Supabase (admin page, live rates, contact messages) ---
# Supabase Dashboard → Project Settings → API / API Keys
NUXT_PUBLIC_SUPABASE_URL=
# "anon public" key (eyJ…) OR new "Publishable" key (sb_publishable_…)
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key (eyJ…) OR new "Secret" key (sb_secret_…) — SECRET, server only.
NUXT_SUPABASE_SERVICE_KEY=

# --- Email notifications for the contact form (optional) ---
# Get a key at https://resend.com
NUXT_RESEND_API_KEY=
# Inbox that receives Support form messages
NUXT_CONTACT_TO=
# Sender address (must be on a domain verified in Resend; the default works for testing)
NUXT_CONTACT_FROM=Plero Website <onboarding@resend.dev>
