# Copy to .env and fill in. Never commit a real token.

# Identifies your app to Deriv. Not a secret — it is sent to the browser.
# Create one at https://app.deriv.com/account/api-token (or your app console).
NUXT_DERIV_APP_ID=1089

# Personal Access Token with the `payment` scope, required for
# GET /wallet/v1/exchange-rate (the real USD/NGN quote).
#
#   Scopes needed:  payment
#   Insufficient scope -> 403, missing/invalid -> 401
#   With no token the site still works, falling back to a public FX source
#   and reporting source "open.er-api.com".
#
# SECURITY: this is read only by server/ routes. It must stay in the private
# half of runtimeConfig — anything under `public` is shipped in the client
# bundle. `npm run smoke` includes a check for that leak.
NUXT_DERIV_TOKEN=